{
  "name": "@filamentjs/rate-limiting",
  "version": "0.1.0",
  "description": "Named multi-bucket rate limiting for FilamentJS",
  "type": "module",
  "main": "./dist/rate-limiting.js",
  "types": "./dist/rate-limiting.d.ts",
  "exports": {
    ".": {
      "types": "./dist/rate-limiting.d.ts",
      "import": "./dist/rate-limiting.js"
    }
  },
  "files": [
    "dist/rate-limiting.js",
    "dist/rate-limiting.js.map",
    "dist/rate-limiting.d.ts",
    "dist/rate-limiting.d.ts.map",
    "dist/src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "link:local-filament": "node scripts/link-local-filament.mjs",
    "test": "npm run link:local-filament && npm run build && node --test dist/test/*.test.js",
    "example": "npm run link:local-filament && npm run build && node dist/example/example.js",
    "demo": "npm run link:local-filament && npm run build && node dist/demo/demo.js",
    "prepack": "npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "filamentjs": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "filamentjs",
    "rate-limit",
    "quota"
  ],
  "license": "ISC"
}
